{
  "name": "fint-status",
  "version": "1.0.0",
  "description": "fint-status",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.0.0",
    "bulma": "^0.9.2",
    "bulma-steps-component": "^0.5.3",
    "trim-newlines": ">=3.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "elm-test": "^0.19.1-revision6",
    "local-cors-proxy": "^1.1.0",
    "trim-newlines": ">=3.0.1",
    "elm": "0.19.1-6",
    "elm-watch": "^1.2.9",
    "vite": "^8.0.0"
  },
  "scripts": {
    "functions-ci": "cd functions && npm ci",
    "start": "concurrently -k \"elm-watch hot\" \"vite\"",
    "proxy": "lcp --proxyUrl https://play-with-fint.felleskomponent.no",
    "test": "npx elm-test --watch",
    "css-build": "node-sass --omit-source-map-url src/main.scss src/main.css",
    "css-watch": "npm run css-build -- --watch",
    "functions": "firebase emulators:start --only functions",
    "dev": "concurrently -k \"npm run proxy\" \"npm start\"",
    "build": "elm-watch make --optimize && vite build",
    "prestart": "elm-watch make"
  },
  "author": "",
  "license": "ISC"
}
